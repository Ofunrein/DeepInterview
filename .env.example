# DeepInterview — environment variables. Copy to .env (never commit .env).
# Run `pnpm deepinterview init` to scaffold this file.

# ── Core / app ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public site URL (used for OG/canonical links). Standard Next.js var.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Agent API (web → agent proxy, worker → prep API) ───────
# The web app proxies report/coach reads to the agent service at this URL,
# and the live worker fetches the precomputed interview plan from it.
# docker-compose overrides this to http://agent-api:8000 (service DNS).
AGENT_API_URL=http://localhost:8000
# Optional shared secret gating the agent API's WRITE endpoints (prep/score/
# coach/kb-ingest and the worker's live-result write-back). Leave blank for local
# dev (endpoints stay open); set the SAME value here and in the agent's env for a
# hosted deployment so the web app + worker are authorized and outsiders aren't.
INTERNAL_API_SECRET=

# ── LiveKit (voice orchestration) ──────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Supabase (Postgres + Auth + Storage) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser auth client reads the NEXT_PUBLIC_-prefixed names (inlined at build).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Cloudflare R2 (CV files + recordings) ──────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── STT (speech-to-text) ───────────────────────────────────
# Default = Deepgram nova-3 (the tested path); set DEEPGRAM_API_KEY.
# Soniox is a BYO alternative — set STT_PROVIDER=soniox + SONIOX_API_KEY.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
SONIOX_API_KEY=

# ── TTS (text-to-speech) ───────────────────────────────────
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# ── LLM (live + prep/post) ─────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Web / company research ─────────────────────────────────
# SEARCH_PROVIDER selects the company-research backend: mock | tavily | exa.
# It defaults to "mock" — setting an API key alone is NOT enough; pick the
# matching provider here too.
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
EXA_API_KEY=

# ── Knowledge service (LightRAG sidecar) ───────────────────
# Leave unset for fully-offline mock knowledge. docker-compose overrides this
# to http://lightrag:9621 (service DNS) for web, agent-api and agent-worker.
LIGHTRAG_URL=http://localhost:9621
LIGHTRAG_PORT=9621
# Optional shared secret gating the sidecar's /kb endpoints. Leave blank for
# local dev; set the SAME value here and in the sidecar's env if you expose it.
LIGHTRAG_API_SECRET=
# Embeddings backend for the sidecar (mock | openai | gemini). Mock = offline.
EMBEDDINGS_PROVIDER=mock

# Payments/billing are NOT part of the open-source build — self-host is
# uncapped and bring-your-own-keys. Paddle/plan-gating lives in the private
# cloud fork, so there are no billing env vars here.

# ── Observability (optional) ───────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
# Browser-side Sentry (inlined at build) + server trace sample rate (0.0–1.0).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
